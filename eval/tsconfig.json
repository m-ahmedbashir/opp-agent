{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "../apps/backend/src/modules/extraction/*.ts",
    "../apps/backend/src/modules/compliance/*.ts",
    "../apps/backend/src/common/prisma/*.ts"
  ],
  "exclude": ["../apps/backend/**/*.spec.ts"]
}
