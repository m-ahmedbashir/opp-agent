# Server Port
PORT=3001

# Server Port
PORT=3001

# OpenRouter API Key (default extraction/planning provider)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key (Required for AI data extraction)
# Get your free key from: https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Google AI Studio)
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key_here

# Which model-registry.ts key the extraction pipeline uses when nothing else
# (a user's own Settings, a per-request override) specifies one. Must be a
# real key from MODEL_REGISTRY in apps/backend/src/modules/extraction/model-registry.ts
# — an unrecognised value silently falls back to the hardcoded FALLBACK_MODEL_KEY.
DEFAULT_MODEL_KEY=google:gemini-3.1-flash-lite

# Email sync cadence — standard cron syntax, seconds field optional (see the
# `cron` npm package). Examples: '*/10 * * * * *' = every 10 seconds (testing,
# 6-field with seconds), '*/5 * * * *' = every 5 minutes (5-field, minutes).
# Omit this var entirely to fall back to every 5 minutes.
EMAIL_SYNC_CRON_EXPRESSION=*/2 * * * *

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Encryption key for user-supplied (BYOK) provider API keys — AES-256-GCM, so this
# must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes any previously-saved user API keys undecryptable — treat
# it like any other production secret, never commit a real value.
BYOK_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

